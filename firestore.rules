rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products - public read, backend Admin SDK for all writes
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Users - each user reads/writes own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders - authenticated user reads own orders only
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }

    // Order Items
    match /order_items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }

    // Wishlist
    match /wishlist/{wishlistId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }

    // Reviews - public read, authenticated create only
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.product_id is string
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // Site Settings - public read, backend writes only
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Lookbook Sections - public read, backend writes only
    match /lookbook_sections/{sectionId} {
      allow read: if true;
      allow write: if false;

      match /items/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Newsletter, Contact, Promo - backend only
    match /newsletter_subscribers/{email} {
      allow read, write: if false;
    }
    match /contact_inquiries/{docId} {
      allow read, write: if false;
    }
    match /promo_codes/{code} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
